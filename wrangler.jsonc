// Cloudflare Workers config: serves site/ as static files and runs site/_worker.js for /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frame-innovations",
  "main": "site/_worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "waitlist", "database_id": "efc2208f-9725-45d3-8fa5-02c71e3bb172" }
  ],
  "observability": { "enabled": true }
}
